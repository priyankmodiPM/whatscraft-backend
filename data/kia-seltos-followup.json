{
  "_comment": "Kia 'Seltos follow-up' scripted demo flow (see Automotive note). Gated to KIA_PHONE. Short/informal WhatsApp copy; 'progress' messages stream a beat apart (GEN_STEP_DELAY_MS, ~2.8s) so a banner reveal feels generated. Flow: nudge -> profile (offers shown as the image_carousel_promo4 carousel TEMPLATE; its quick-reply payloads offer_low_emi/offer_insurance_off/offer_zero_down advance the flow) -> pick 1 of 3 insurance plans -> add contact -> render preview -> localize to Hindi + on-road price. Swap the Scene7 banner URLs / contact number as needed. Engine: src/scriptedFlow.js.",
  "phone": "919899860983",
  "start": "kickoff",
  "steps": {
    "kickoff": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Hey Rahul 👋\nApoorva test-drove the Seltos 4 days ago — no follow-up yet.\nWanna nudge her?",
          "options": ["✅ Yes, follow up", "🙅 Not now"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes follow up", "next": "profile" },
          { "match": "Not now", "next": "not_now" }
        ],
        "reask": [
          { "type": "buttons", "body": "Shall I nudge Apoorva?", "options": ["✅ Yes, follow up", "🙅 Not now"] }
        ]
      }
    },

    "not_now": {
      "onEnter": [
        { "type": "text", "text": "No worries — I'll keep the lead warm and ping you later 👍" }
      ]
    },

    "profile": {
      "onEnter": [
        {
          "type": "text",
          "text": "Pulled up Apoorva's profile 📋\n• 📱 +91 98213 47762\n• Test-drove the Seltos HTK\n• Exchange car on file"
        },
        {
          "_comment": "The available offers are shown as the image_carousel_promo4 message template (a WhatsApp carousel). Its quick-reply buttons come back as message.button.payload — offer_low_emi / offer_insurance_off / offer_zero_down, one per card — which the await gate below matches. Executed by runScriptedSends → sendTemplate in src/app.js; must send from the KIA_WHATSAPP account the template is attached to (1174719859057684).",
          "type": "template",
          "historyText": "Here are the offers that'd work for her 👇 Which one should I run with?",
          "fallback": {
            "_comment": "Sent instead of the carousel if the template send fails, so the offers still appear in the SAME turn (no reply needed). Option titles are matched by this step's await gate (Low EMI / Insurance Off / Zero Down Payment).",
            "type": "buttons",
            "image": "https://s7ap1.scene7.com/is/image/varunAEM/kia-offers-merged?cache=off",
            "body": "Here are 3 offers that'd work for her 👇\nWhich one should I run with?",
            "options": ["💳 Low EMI", "🛡️ Insurance Off", "0️⃣ Zero Down Payment"]
          },
          "template": {
            "name": "image_carousel_promo4",
            "language": { "code": "en_US" },
            "components": [
              { "type": "body", "parameters": [ { "type": "text", "text": "Rahul" } ] },
              {
                "type": "carousel",
                "cards": [
                  {
                    "card_index": 0,
                    "components": [
                      { "type": "header", "parameters": [ { "type": "image", "image": { "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-offer-insurance?cache=off" } } ] },
                      { "type": "button", "sub_type": "quick_reply", "index": 0, "parameters": [ { "type": "payload", "payload": "offer_low_emi" } ] }
                    ]
                  },
                  {
                    "card_index": 1,
                    "components": [
                      { "type": "header", "parameters": [ { "type": "image", "image": { "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-offer-lowemi?cache=off" } } ] },
                      { "type": "button", "sub_type": "quick_reply", "index": 0, "parameters": [ { "type": "payload", "payload": "offer_insurance_off" } ] }
                    ]
                  },
                  {
                    "card_index": 2,
                    "components": [
                      { "type": "header", "parameters": [ { "type": "image", "image": { "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-offer-zerodown?cache=off" } } ] },
                      { "type": "button", "sub_type": "quick_reply", "index": 0, "parameters": [ { "type": "payload", "payload": "offer_zero_down" } ] }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "offer_low_emi", "next": "insurance_plan" },
          { "match": "offer_insurance_off", "next": "insurance_plan" },
          { "match": "offer_zero_down", "next": "insurance_plan" },
          { "match": "Low EMI", "next": "insurance_plan" },
          { "match": "Zero Down Payment", "next": "insurance_plan" },
          { "match": "Insurance Off", "next": "insurance_plan" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Pick one of the offers to run with.",
            "options": ["💳 Low EMI", "🛡️ Insurance Off"]
          }
        ]
      }
    },

    "insurance_plan": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Nice — going with the insurance offer 🛡️\nLet's lock the plan that goes on the banner.\n\nWhich insurance plan should I feature?",
          "options": ["3-Yr Comprehensive", "Zero Dep + RSA", "Engine Protect"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "3-Yr Comprehensive", "next": "ask_contact" },
          { "match": "Zero Dep RSA", "next": "ask_contact" },
          { "match": "Engine Protect", "next": "ask_contact" }
        ],
        "reask": [
          { "type": "buttons", "body": "Pick an insurance plan to feature.", "options": ["3-Yr Comprehensive", "Zero Dep + RSA", "Engine Protect"] }
        ]
      }
    },

    "ask_contact": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "On it — building the Seltos HTK banner with that offer 🎯\nFestive pricing + exchange note, all in.\n\nAdd your name & number so she can reach you?",
          "options": ["✅ Yes, add it", "🙅 No, skip"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes add it", "next": "render_with_contact" },
          { "match": "No skip", "next": "render_no_contact" }
        ],
        "reask": [
          { "type": "buttons", "body": "Add your name & number to the banner?", "options": ["✅ Yes, add it", "🙅 No, skip"] }
        ]
      }
    },

    "render_with_contact": {
      "onEnter": [
        { "type": "text", "text": "Added your contact 📇 Rahul · +91 98998 60983" },
        { "type": "text", "text": "Got it — building your banner now… 🎯" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos HTK…" },
        { "type": "progress", "text": "📇 Placing your contact…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "render_no_contact": {
      "onEnter": [
        { "type": "text", "text": "No problem — no contact on this one 👍" },
        { "type": "text", "text": "Got it — building your banner now… 🎯" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos HTK…" },
        { "type": "progress", "text": "🏷️ Adding the festive pricing…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "localize": {
      "onEnter": [
        { "type": "progress", "text": "✍️ Translating to Hindi…" },
        { "type": "progress", "text": "🧾 Calculating state tax & applying offers…" },
        { "type": "progress", "text": "💰 Calculating the final on-road price…" },
        { "type": "progress", "text": "🎨 Re-rendering the banner…" },
        {
          "type": "text",
          "text": "Done ✅\nSame banner, now in Hindi 🇮🇳\nFinal on-road price added too.\n(branding + layout untouched)"
        },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v2?cache=off",
          "caption": "Ready to send to Apoorva 🎉"
        }
      ]
    }
  }
}
