{
  "_comment": "Kia 'Seltos follow-up' scripted demo flow (see Automotive note). Gated to KIA_PHONE. Copy is short/informal for WhatsApp. 'progress' messages stream a beat apart (GEN_STEP_DELAY_MS, ~1.6s) to make a banner reveal feel generated. Swap the Scene7 banner URLs / contact number as needed. Engine: src/scriptedFlow.js.",
  "phone": "919899860983",
  "start": "kickoff",
  "steps": {
    "kickoff": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Hey Rahul 👋\nApoorva test-drove the Seltos 4 days ago — no follow-up yet.\nWanna nudge her?",
          "options": ["✅ Yes, follow up", "🙅 Not now"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes follow up", "next": "profile" },
          { "match": "Not now", "next": "not_now" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Shall I nudge Apoorva?",
            "options": ["✅ Yes, follow up", "🙅 Not now"]
          }
        ]
      }
    },

    "not_now": {
      "onEnter": [
        { "type": "text", "text": "No worries — I'll keep the lead warm and ping you later 👍" }
      ]
    },

    "profile": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Pulled up her profile 📋\n• Test-drove the HTK\n• Exchange car on file\n• Wanted a car + insurance combo\n\nShall I make a banner for it?",
          "options": ["✅ Yes, go ahead", "🙅 No"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes go ahead", "next": "offer" },
          { "match": "No", "next": "no_banner" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Shall I build the banner?",
            "options": ["✅ Yes, go ahead", "🙅 No"]
          }
        ]
      }
    },

    "no_banner": {
      "onEnter": [
        { "type": "text", "text": "All good — ping me whenever and I'll build it 👍" }
      ]
    },

    "offer": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Which insurance offer should I feature? 🛡️\nPick what Apoorva's most likely to go for:",
          "options": ["🛡️ Zero Dep Cover", "🔧 Engine + RSA", "📅 3-Yr Comprehensive"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Zero Dep Cover", "next": "ask_contact" },
          { "match": "Engine + RSA", "next": "ask_contact" },
          { "match": "3-Yr Comprehensive", "next": "ask_contact" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Tap an insurance offer to feature:",
            "options": ["🛡️ Zero Dep Cover", "🔧 Engine + RSA", "📅 3-Yr Comprehensive"]
          }
        ]
      }
    },

    "ask_contact": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Nice pick 👍\nBuilding the Seltos HTK + insurance combo now 🎯\nFestive pricing + exchange note, all in.\n\nAdd your name & number so she can reach you?",
          "options": ["✅ Yes, add it", "🙅 No, skip"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes add it", "next": "render_with_contact" },
          { "match": "No skip", "next": "render_no_contact" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Add your name & number to the banner?",
            "options": ["✅ Yes, add it", "🙅 No, skip"]
          }
        ]
      }
    },

    "render_with_contact": {
      "onEnter": [
        { "type": "text", "text": "Adding your contact 📇\nRahul · +91 98998 60983" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos + combo…" },
        { "type": "progress", "text": "📇 Placing your contact…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "render_no_contact": {
      "onEnter": [
        { "type": "text", "text": "Cool, no contact on this one 👍" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos + combo…" },
        { "type": "progress", "text": "🏷️ Adding the festive pricing…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "localize": {
      "onEnter": [
        { "type": "progress", "text": "✍️ Translating to Hindi…" },
        { "type": "progress", "text": "💰 Adding the on-road price…" },
        { "type": "progress", "text": "🎨 Re-rendering the banner…" },
        {
          "type": "text",
          "text": "Done ✅\nSame banner, now in Hindi 🇮🇳\nFinal on-road price added too.\n(branding + layout untouched)"
        },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v2?cache=off",
          "caption": "Ready to send to Apoorva 🎉"
        }
      ]
    }
  }
}
