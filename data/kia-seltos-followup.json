{
  "_comment": "Kia 'Seltos follow-up' scripted demo flow (see Automotive note). Gated to KIA_PHONE. Short/informal WhatsApp copy; 'progress' messages stream a beat apart (GEN_STEP_DELAY_MS, ~2.8s) so a banner reveal feels generated. Flow: nudge -> profile (pick 1 of 3 offers; merged image rides in the SAME interactive message as the buttons) -> pick 1 of 3 insurance plans -> add contact -> render preview -> localize to Hindi + on-road price. Swap the Scene7 banner URLs / contact number as needed. Engine: src/scriptedFlow.js.",
  "phone": "919899860983",
  "start": "kickoff",
  "steps": {
    "kickoff": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Hey Rahul 👋\nApoorva test-drove the Seltos 4 days ago — no follow-up yet.\nWanna nudge her?",
          "options": ["✅ Yes, follow up", "🙅 Not now"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes follow up", "next": "profile" },
          { "match": "Not now", "next": "not_now" }
        ],
        "reask": [
          { "type": "buttons", "body": "Shall I nudge Apoorva?", "options": ["✅ Yes, follow up", "🙅 Not now"] }
        ]
      }
    },

    "not_now": {
      "onEnter": [
        { "type": "text", "text": "No worries — I'll keep the lead warm and ping you later 👍" }
      ]
    },

    "profile": {
      "onEnter": [
        {
          "type": "text",
          "text": "Pulled up her profile 📋\n• Test-drove the HTK\n• Exchange car on file\n• Wanted a car + insurance combo"
        },
        {
          "type": "buttons",
          "image": "https://s7ap1.scene7.com/is/image/varunAEM/kia-offers-merged?cache=off",
          "body": "Here are 3 offers that'd work for her 👇\nWhich one should I run with?",
          "options": ["💳 Low EMI", "0️⃣ Zero Down Payment", "🛡️ Insurance Off"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Low EMI", "next": "insurance_plan" },
          { "match": "Zero Down Payment", "next": "insurance_plan" },
          { "match": "Insurance Off", "next": "insurance_plan" }
        ],
        "reask": [
          {
            "type": "buttons",
            "body": "Pick one of the 3 offers to run with.",
            "options": ["💳 Low EMI", "0️⃣ Zero Down Payment", "🛡️ Insurance Off"]
          }
        ]
      }
    },

    "insurance_plan": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "Nice — going with the insurance offer 🛡️\nShe wanted a car + insurance combo, so let's lock the plan that goes on the banner.\n\nWhich insurance plan should I feature?",
          "options": ["3-Yr Comprehensive", "Zero Dep + RSA", "Engine Protect"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "3-Yr Comprehensive", "next": "ask_contact" },
          { "match": "Zero Dep RSA", "next": "ask_contact" },
          { "match": "Engine Protect", "next": "ask_contact" }
        ],
        "reask": [
          { "type": "buttons", "body": "Pick an insurance plan to feature.", "options": ["3-Yr Comprehensive", "Zero Dep + RSA", "Engine Protect"] }
        ]
      }
    },

    "ask_contact": {
      "onEnter": [
        {
          "type": "buttons",
          "body": "On it — building the Seltos HTK banner with that offer 🎯\nFestive pricing + exchange note, all in.\n\nAdd your name & number so she can reach you?",
          "options": ["✅ Yes, add it", "🙅 No, skip"]
        }
      ],
      "await": {
        "kind": "buttons",
        "options": [
          { "match": "Yes add it", "next": "render_with_contact" },
          { "match": "No skip", "next": "render_no_contact" }
        ],
        "reask": [
          { "type": "buttons", "body": "Add your name & number to the banner?", "options": ["✅ Yes, add it", "🙅 No, skip"] }
        ]
      }
    },

    "render_with_contact": {
      "onEnter": [
        { "type": "text", "text": "Added your contact 📇 Rahul · +91 98998 60983" },
        { "type": "text", "text": "Got it — building your banner now… 🎯" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos + combo…" },
        { "type": "progress", "text": "📇 Placing your contact…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "render_no_contact": {
      "onEnter": [
        { "type": "text", "text": "No problem — no contact on this one 👍" },
        { "type": "text", "text": "Got it — building your banner now… 🎯" },
        { "type": "progress", "text": "🎨 Laying out the design…" },
        { "type": "progress", "text": "🚗 Dropping in the Seltos + combo…" },
        { "type": "progress", "text": "🏷️ Adding the festive pricing…" },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v1?cache=off",
          "caption": "Here's the preview 👇 how's it looking?"
        }
      ],
      "await": { "kind": "any", "next": "localize" }
    },

    "localize": {
      "onEnter": [
        { "type": "progress", "text": "✍️ Translating to Hindi…" },
        { "type": "progress", "text": "💰 Adding the on-road price…" },
        { "type": "progress", "text": "🎨 Re-rendering the banner…" },
        {
          "type": "text",
          "text": "Done ✅\nSame banner, now in Hindi 🇮🇳\nFinal on-road price added too.\n(branding + layout untouched)"
        },
        {
          "type": "image",
          "link": "https://s7ap1.scene7.com/is/image/varunAEM/Kia-v2?cache=off",
          "caption": "Ready to send to Apoorva 🎉"
        }
      ]
    }
  }
}
